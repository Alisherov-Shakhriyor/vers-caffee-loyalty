# ==========================================
# VERS CAFFEE LOYALTY — Environment Variables
# ==========================================

# --- Frontend Firebase Web Configuration (Public) ---
# Available in Firebase Console > Project Settings > General > Your Apps
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=vers-caffee-loyalty.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=vers-caffee-loyalty
VITE_FIREBASE_STORAGE_BUCKET=vers-caffee-loyalty.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# --- Backend Configuration (Cloud Functions & Serverless API - Private) ---
# Telegram Bot Token from @BotFather (used to cryptographically verify WebApp initData HMAC-SHA256)
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Service Account (for local development or Vercel serverless functions)
# Download from Firebase Console > Project Settings > Service Accounts > Generate new private key
FIREBASE_PROJECT_ID=vers-caffee-loyalty
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@vers-caffee-loyalty.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Business Settings
TIMEZONE=Asia/Tashkent
DAILY_STAMP_LIMIT=1
REWARD_THRESHOLD=10
